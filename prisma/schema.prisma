generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String
  mensaje   String
  empresa   String
  fecha     DateTime @default(now())
  score     Int
  estado    String
}